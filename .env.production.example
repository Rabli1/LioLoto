APP_NAME=LioLoto
APP_ENV=production
# Generate once: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Keep this key across releases; supply it through your secret store.
APP_KEY=
APP_DEBUG=false
APP_URL=https://games.example.com
# Set the IP/CIDR that Apache actually sees for your HTTPS reverse proxy.
# Required for HTTPS forwarding and signed account confirmation links.
# Example: TRUSTED_PROXIES=172.20.0.1
TRUSTED_PROXIES=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Compose persists this SQLite database in the application storage volume.
# For multiple app replicas, use a shared MySQL database instead.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=lioloto
# DB_USERNAME=lioloto
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Account confirmation needs a working SMTP provider.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=LioLoto

# Bind privately behind an HTTPS reverse proxy.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
